{
  "name": "bridge-building-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html 'Play Span.html' && vite build --config vite.story.config.ts && cp dist-story/story.html 'Bridge Story.html'",
    "preview": "vite preview",
    "test:physics": "tsx scripts/headless-test.ts",
    "test:tutorial": "tsx scripts/tutorial-check.ts",
    "test:playground": "tsx scripts/playground-smoke.ts",
    "video": "tsx scripts/record-video.ts && npm run build",
    "test:examples": "tsx scripts/examples-check.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "playwright": "^1.48.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  }
}